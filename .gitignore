# macOS
.DS_Store

# R session/local files
.Rhistory
.RData
.R*data
.Rproj.*/

# R environment/local libraries
.Renviron
renv/library/
renv/staging/

# Quarto / knitr / misc outputs
*.html
*.log
*.tmp
*.bak
*.swp

# Python cache
__pycache__/
*.pyc

# Local secrets / env files
.env
.env.*

# Data (raw/processed/reference)
data/raw/*
data/processed/*
data/reference/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/reference/.gitkeep

# Generated outputs
outputs/*
!outputs/.gitkeep
!outputs/models/
!outputs/results/
!outputs/tables/
!outputs/figures/
outputs/models/*
!outputs/models/.gitkeep
outputs/results/*
!outputs/results/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep
outputs/figures/*
!outputs/figures/.gitkeep

# schema/output dumps generated during analysis
*.rds
*.Rds
*.RDS

# tracked repository docs/config/scripts/code
!README.md
!config/**
!R/**
!scripts/**
!schemas/**
